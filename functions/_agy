#compdef agy antigravity
#autoload

# Completion for the Antigravity CLI (agy). Generated from `agy --help` and
# `agy help <subcommand>`.

function _agy() {
  local curcontext="$curcontext" state line
  typeset -A opt_args

  local -a agy_modes agy_efforts agy_output_formats agy_input_formats
  agy_modes=(accept-edits plan)
  agy_efforts=(low medium high)
  agy_output_formats=(text json stream-json)
  agy_input_formats=(text stream-json)

  local -a agy_commands
  agy_commands=(
    'agent:List available agents'
    'agents:List available agents'
    'changelog:Show changelog and release notes'
    'help:Show help for subcommands'
    'install:Configure environment paths and shell settings'
    'mcp:Manage MCP servers (add, remove, list, enable, disable)'
    'mic-serve:Serve this machine'\''s microphone to a CLI on another host'
    'models:List available models'
    'plugin:Manage plugins (install, uninstall, list, enable, disable)'
    'plugins:Alias for plugin'
    'update:Update CLI'
  )

  _arguments -C \
    '*--add-dir[Add a directory to the workspace (repeatable)]:directory:_files -/' \
    '--agent[Agent for the current CLI session]:agent:' \
    '(-c --continue)'{-c,--continue}'[Continue the most recent conversation]' \
    '--conversation[Resume a previous conversation by ID]:conversation id:' \
    '--dangerously-skip-permissions[Auto-approve all tool permission requests]' \
    '--disable-slash-commands[Disable slash command and skill expansion in print mode]' \
    '--effort[Reasoning effort for the current CLI session]:effort:('"${agy_efforts[*]}"')' \
    '(-i --prompt-interactive)'{-i,--prompt-interactive}'[Run an initial prompt interactively and continue the session]:prompt:' \
    '--input-format[Input format for print mode]:format:('"${agy_input_formats[*]}"')' \
    '--json-schema[JSON schema string or path enforcing structured output]:schema:_files' \
    '--log-file[Override CLI log file path]:log file:_files' \
    '--mode[Set the agent execution mode for this session]:mode:('"${agy_modes[*]}"')' \
    '--model[Model for the current CLI session]:model:' \
    '--new-project[Create a new project for this session]' \
    '--output-format[Output format for print mode]:format:('"${agy_output_formats[*]}"')' \
    '(-p --print --prompt)'{-p,--print,--prompt}'[Run a single prompt non-interactively and print the response]:prompt:' \
    '--print-timeout[Timeout for print mode wait]:duration:' \
    '--project[Project ID or project name for the current CLI session]:project:' \
    '--sandbox[Run in a sandbox with terminal restrictions enabled]' \
    '(-h --help)'{-h,--help}'[Show help]' \
    '1:command:->command' \
    '*::arg:->args'

  case $state in
    command)
      _describe -t commands 'agy command' agy_commands
      ;;
    args)
      case $words[1] in
        mcp)
          _agy_mcp
          ;;
        plugin|plugins)
          _agy_plugin
          ;;
        install)
          _arguments \
            '--dir[Custom directory target to configure PATH for]:directory:_files -/' \
            '--skip-aliases[Bypass shell profile alias purging]' \
            '--skip-path[Bypass shell profile PATH appending]' \
            '(-h --help)'{-h,--help}'[Show help]'
          ;;
        mic-serve)
          _arguments \
            '--addr[Address to listen on (default 127.0.0.1:4713)]:address:' \
            '(-h --help)'{-h,--help}'[Show help]'
          ;;
        help)
          _describe -t commands 'agy command' agy_commands
          ;;
        *)
          _arguments '(-h --help)'{-h,--help}'[Show help]'
          ;;
      esac
      ;;
  esac
}

function _agy_mcp() {
  local -a subcommands
  subcommands=(
    'add:Add or update an MCP server configuration'
    'remove:Remove an MCP server configuration'
    'list:List all configured MCP servers'
    'enable:Enable an MCP server'
    'disable:Disable an MCP server'
  )

  _arguments -C \
    '1:subcommand:->subcommand' \
    '*::arg:->args'

  case $state in
    subcommand)
      _describe -t commands 'agy mcp subcommand' subcommands
      ;;
    args)
      _arguments '(-h --help)'{-h,--help}'[Show help]'
      ;;
  esac
}

function _agy_plugin() {
  local -a subcommands
  subcommands=(
    'list:List imported plugins'
    'import:Import plugins from gemini or claude'
    'install:Install a plugin (supports plugin@marketplace)'
    'uninstall:Uninstall a plugin'
    'enable:Enable a plugin'
    'disable:Disable a plugin'
    'validate:Validate a plugin'
    'link:Generate link to a marketplace'
    'help:Show plugin help'
  )

  _arguments -C \
    '1:subcommand:->subcommand' \
    '*::arg:->args'

  case $state in
    subcommand)
      _describe -t commands 'agy plugin subcommand' subcommands
      ;;
    args)
      case $words[1] in
        import)
          _values 'source' gemini claude
          ;;
        validate)
          _files -/
          ;;
        *)
          _default
          ;;
      esac
      ;;
  esac
}

_agy "$@"
